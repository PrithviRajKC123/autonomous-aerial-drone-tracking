<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="simple_robot">
    <pose>0 0 1.5 0 0 0</pose>
    <link name="base_link">

      <!-- Main body - yellow -->
      <visual name="body_visual">
        <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
        <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
      </collision>

      <!-- Arm Front - white -->
      <visual name="arm1">
        <pose>0.3 0 0 0 0 0</pose>
        <geometry><box><size>0.3 0.05 0.03</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>

      <!-- Arm Back - white -->
      <visual name="arm2">
        <pose>-0.3 0 0 0 0 0</pose>
        <geometry><box><size>0.3 0.05 0.03</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>

      <!-- Arm Left - white -->
      <visual name="arm3">
        <pose>0 0.3 0 0 0 0</pose>
        <geometry><box><size>0.05 0.3 0.03</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>

      <!-- Arm Right - white -->
      <visual name="arm4">
        <pose>0 -0.3 0 0 0 0</pose>
        <geometry><box><size>0.05 0.3 0.03</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>

      <!-- Propeller Front - green -->
      <visual name="prop1">
        <pose>0.45 0 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>

      <!-- Propeller Back - green -->
      <visual name="prop2">
        <pose>-0.45 0 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>

      <!-- Propeller Left - green -->
      <visual name="prop3">
        <pose>0 0.45 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>

      <!-- Propeller Right - green -->
      <visual name="prop4">
        <pose>0 -0.45 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>

      <!-- Camera - forward slightly down -->
      <sensor name="camera" type="camera">
        <pose>0.15 0 -0.05 0 0.3 0</pose>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/camera/image_raw</topic>
      </sensor>

    </link>
  </model>
</sdf>
